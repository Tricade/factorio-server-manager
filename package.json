{
  "name": "factorio-server-manager",
  "version": "0.17.5",
  "private": true,
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  },
  "description": "Factorio Server Control UI",
  "main": "ui/index.js",
  "scripts": {
    "dev": "npm run development",
    "development": "webpack --config=webpack.config.js --mode=development --progress",
    "watch": "npm run development -- --watch",
    "watch-poll": "npm run watch -- --watch-poll",
    "build": "npm run production",
    "prod": "npm run production",
    "production": "cross-env NODE_ENV=production webpack --config=webpack.config.js --mode=production --progress",
    "test": "node --test ui/tests/*.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tricade/factorio-server-manager.git"
  },
  "author": "Mitch Roote <mitch@r00t.ca>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tricade/factorio-server-manager/issues"
  },
  "homepage": "https://github.com/Tricade/factorio-server-manager#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^9.2.1",
    "classnames": "^2.5.1",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "file-loader": "^6.2.0",
    "locks": "^0.2.2",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^7.3.4",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native-listener": "^1.1.0",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.3",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.103.1",
    "sass-loader": "^13.3.3",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.110.2",
    "webpack-cli": "^5.1.4",
    "webpack-fix-style-only-entries": "^0.6.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "axios": "^1.20.0",
    "fuse.js": "^7.5.0",
    "react-hook-form": "^7.87.0",
    "regenerator-runtime": "^0.14.1",
    "semver": "^7.8.5",
    "tailwindcss": "^3.4.19"
  }
}
