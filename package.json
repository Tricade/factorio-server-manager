{
  "name": "factorio-server-manager",
  "version": "0.20.2",
  "private": true,
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  },
  "description": "Factorio Server Control UI",
  "main": "ui/index.js",
  "scripts": {
    "dev": "npm run development",
    "development": "webpack --config=webpack.config.js --mode=development --progress",
    "watch": "npm run development -- --watch",
    "watch-poll": "npm run watch -- --watch-poll",
    "build": "npm run production",
    "prod": "npm run production",
    "production": "cross-env NODE_ENV=production webpack --config=webpack.config.js --mode=production --progress",
    "test": "node --test ui/tests/*.test.cjs",
    "test:browser": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tricade/factorio-server-manager.git"
  },
  "author": "Mitch Roote <mitch@r00t.ca>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tricade/factorio-server-manager/issues"
  },
  "homepage": "https://github.com/Tricade/factorio-server-manager#readme",
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "babel-loader": "^9.2.1",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "file-loader": "^6.2.0",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^7.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "react-router": "7.18.4",
    "react-router-dom": "7.18.4",
    "tailwindcss": "^4.3.3",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "axios": "^1.20.0",
    "events": "^3.3.0",
    "fuse.js": "^7.5.0",
    "react-hook-form": "^7.90.0",
    "regenerator-runtime": "^0.14.1",
    "semver": "^7.8.5"
  }
}
